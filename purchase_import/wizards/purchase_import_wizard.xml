<odoo>
    <!-- Wizard principal: Formulario para seleccionar productos desde una OC -->
    <record id="view_purchase_import_wizard_form" model="ir.ui.view">
        <field name="name">purchase.import.wizard.form</field>
        <field name="model">purchase.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Select Products for Import">
                <field name="allowed_purchase_ids" invisible="1"/>     
                <group>
                    <field name="import_id" readonly="1"/>
                    <field name="purchase_order_id"/>
                </group>
                <field name="line_ids">
                    <list editable="bottom">
                        <field name="product_id"/>
                        <field name="product_qty"/>
                    </list>
                </field>
                <footer>
                    <button string="Add to Import" type="object" name="action_add_products" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
