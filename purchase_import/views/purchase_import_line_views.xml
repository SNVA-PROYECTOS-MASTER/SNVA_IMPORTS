<odoo>
    <!-- Herencia para agregar pestaña de líneas como solo lectura -->
    <record id="view_purchase_import_form_inherit_lines" model="ir.ui.view">
        <field name="name">purchase.import.form.inherit.lines</field>
        <field name="model">purchase.import</field>
        <field name="inherit_id" ref="purchase_import.view_purchase_import_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Products">
                        <field name="import_line_ids" >
                            <list>
                                <field name="product_id"/>
                                <field name="purchase_order_id"/>
                                <field name="product_qty"/>
                                <field name="qty_received"/>
                            </list>
                        </field>
                    </page>
                    <page string="Payments">
                        <field name="payment_ids">
                            <list>
                                <field name="name"/>
                                <field name="payment_type"/>
                                <field name="partner_id"/>
                                <field name="amount"/>
                                <field name="currency_id"/>
                                <field name="journal_id"/>
                                <field name="state"/>
                            </list>
                        </field>
                    </page>

                </notebook>
            </xpath>


            <xpath expr="//notebook" position="inside">
                <page string="Documentos" invisible = "state != 'confirmed'">
                    <group>
                        <field name="document_folder_id" readonly="1"/>
                    </group>


                    <field name="document_list">
                        <kanban>
                            <field name="name"/>
                            <field name="thumbnail"/>
                            <templates>
                                <t t-name="card" class="flex-row">
                                    <aside class="o_kanban_aside_full">
                                        <field name="thumbnail" class="o_kanban_image_fill w-100" widget="image" options="{'img_class': 'object-fit-cover'}" alt="Contact image"/>
                                    </aside>
                                    <main>
                                        <field name="name"/>
                                    </main>
                                </t>
                            </templates>
                        </kanban>
                    </field>
                    
                </page>
            </xpath>
        </field>
    </record>
</odoo>
