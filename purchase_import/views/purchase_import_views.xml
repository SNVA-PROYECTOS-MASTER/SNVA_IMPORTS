<odoo>
    <!-- Vista Formulario -->
    <record id="view_purchase_import_form" model="ir.ui.view">
        <field name="name">purchase.import.form</field>
        <field name="model">purchase.import</field>
        <field name="arch" type="xml">
            <form string="Purchase Import">
                <header>
                        <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                        <!-- Confirmar: validación se hace en Python -->
                        <button name="action_confirm"
                                type="object"
                                string="Confirm"
                                class="btn-primary"/> 
                </header>
                <sheet>
                    
                    <group col="2">
                        <!-- Columna izquierda -->
                        <group>
                            <field name="name"/>
                            <field name="purchase_ids" widget="many2many_tags"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="tracking_number"/>
                            <field name="notes"/>
                        </group>

                        <!-- Columna derecha: logística -->
                        <group string="Logistics">
                            <field name="transport_type"/>
                            <field name="incoterm_id"/>
                            <field name="origin_country"/>
                            <field name="port_of_loading"/>
                            <field name="port_of_discharge"/>
                            <field name="departure_date" widget="date"/>
                            <field name="arrival_date"  widget="date"/>
                            <!-- <field name="carrier_id"/> -->
                        </group>
                    </group>

                    <group>
                        <field name="notes"/>
                    </group>
                    
                </sheet>
                <chatter>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </chatter>
                
                
            </form>
        </field>
    </record>

    <!-- Vista Lista -->
    <record id="view_purchase_import_list" model="ir.ui.view">
        <field name="name">purchase.import.list</field>
        <field name="model">purchase.import</field>
        <field name="arch" type="xml">
            <list string="Purchase Imports">
                <field name="name"/>
                <field name="purchase_ids"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Menús -->
    <menuitem id="menu_purchase_import_root" name="Imports" sequence="10"/>
    <menuitem id="menu_purchase_import_main" name="Purchase Imports" parent="menu_purchase_import_root"/>

    <!-- Acción de ventana -->
    <record id="action_purchase_import" model="ir.actions.act_window">
        <field name="name">Imports</field>
        <field name="res_model">purchase.import</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_purchase_import_action"
        name="Imports"
        parent="menu_purchase_import_main"
        action="action_purchase_import"/>
</odoo>
