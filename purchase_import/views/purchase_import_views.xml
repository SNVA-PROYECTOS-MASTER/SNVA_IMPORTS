<odoo>
    <!-- Vista Formulario -->
    <record id="view_purchase_import_form" model="ir.ui.view">
        <field name="name">purchase.import.form</field>
        <field name="model">purchase.import</field>
        <field name="arch" type="xml">
            <form string="Purchase Import">
                <!-- <div name="button_box" class="oe_button_box"/> -->
                <!-- Header buttons -->
                <header>
                    
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>

                    <button name="action_confirm"
                            type="object"
                            string="Confirm"
                            class="btn-primary"/>

                    <button name="action_open_wizard"
                            type="object"
                            string="Add Products"
                            class="oe_highlight"
                            invisible="purchase_ids == False "/>

                    <button name="action_create_reception"
                            type="object"
                            invisible = "state != 'confirm'"
                            string="Create Receipt"
                            class="oe_highlight"
                            icon="fa-truck"/>
                </header>

                <!-- Form body -->
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button name="action_view_purchase_orders"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-shopping-cart"
                                invisible="not purchase_ids">
                            <field name="purchase_ids" widget="statinfo" string="Purchase Orders"/>
                        </button>

                        <button name="action_view_pickings"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-truck"
                                invisible="not picking_ids">
                            <field name="picking_ids" widget="statinfo" string="Receipts"/>
                        </button>
                    </div>
                    <group col="2">
                        <!-- Left column -->
                        <group>
                            <field name="name"/>
                            <field name="purchase_ids" widget="many2many_tags"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="tracking_number"/>
                        </group>

                        <!-- Right column: logistics -->
                        <group string="Logistics">
                            <field name="transport_type"/>
                            <field name="incoterm_id"/>
                            <field name="origin_country_id"/>
                            <field name="port_of_loading"/>
                            <field name="port_of_discharge"/>
                            <field name="departure_date" widget="date"/>
                            <field name="arrival_date" widget="date"/>
                            <field name="picking_type_id"/>
                        </group>

                        <group string="Shipping Details" col="2">
                            <field name="bl_number"/>
                            <field name="trading_contact_id"/>
                            <field name="currency_id"/>
                            <field name="trm_value"/>
                        </group>
                    </group>

                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>

                <!-- Chatter -->
                <chatter>
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </chatter>

            </form>
        </field>
    </record>

    <!-- Vista Lista -->
    <record id="view_purchase_import_list" model="ir.ui.view">
        <field name="name">purchase.import.list</field>
        <field name="model">purchase.import</field>
        <field name="arch" type="xml">
            <list string="Purchase Imports">
                <field name="name"/>
                <field name="purchase_ids"/>
                <field name="state"/>
                <field name="transport_type"/>
                <field name="incoterm_id"/>
                <field name="origin_country_id"/>
                <field name="port_of_loading"/>
                <field name="port_of_discharge"/>
            </list>
        </field>
    </record>

    <!-- Menús -->
    <menuitem id="menu_purchase_import_root" name="Imports" sequence="10"   web_icon="purchase_import,static/description/icon.png"/>
    <menuitem id="menu_purchase_import_main" name="Purchase Imports" parent="menu_purchase_import_root"/>

    <!-- Acción de ventana -->
    <record id="action_purchase_import" model="ir.actions.act_window">
        <field name="name">Imports</field>
        <field name="res_model">purchase.import</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_purchase_import_main"
        name="Purchase Imports"
        action="action_purchase_import"
        web_icon="purchase_import,static/description/icon.png"
        sequence="1"/>

</odoo>
