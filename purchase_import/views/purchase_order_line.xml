<odoo>
    <record id="purchase_order_form_inherit_supplierdesc" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.supplierdesc</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
        <!-- Agrega la columna después de product_id -->
        <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="after">
            <field name="supplier_description" string="Descripción Proveedor" optional="show"/>
            <field name="number_part" string="Number part"  optional="show"/>
        </xpath>
        </field>
    </record>
</odoo>
