<odoo>
    <record id="view_product_supplierinfo_tree_inherit_description" model="ir.ui.view">
        <field name="name">product.supplierinfo.tree.inherit.description</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="purchase.product_supplierinfo_tree_view2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='price']" position="after">
                <field name="description_import"/>
            </xpath>
        </field>
    </record>
</odoo>
